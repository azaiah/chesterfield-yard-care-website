# Copy to .env.local and fill in. Never commit .env.local. Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
KIE_API_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_SECRET_KEY=
OWNER_ALERT_PHONE=
OWNER_ALERT_EMAIL=

# --- Phase 2: quote flow ---
# Signs the step-2 token. Any long random string.
LEAD_TOKEN_SECRET=
# Email "from" (verified domain in Resend)
RESEND_FROM=
# Texting stays off until Twilio A2P 10DLC registration is approved (docs/SMS_A2P_10DLC.md)
SMS_ENABLED=false
# Cloudflare Turnstile (optional spam check)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Analytics (optional)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
